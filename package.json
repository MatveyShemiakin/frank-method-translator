{
  "name": "frank-method-translator",
  "version": "1.0.0",
  "description": "Web and CLI tool for transforming English texts into an Ilya Frank-style bilingual reading format.",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node server/proxy.js",
    "cli": "node cli/frankify.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "translation",
    "language-learning",
    "ilya-frank-method",
    "bilingual-reader",
    "openai"
